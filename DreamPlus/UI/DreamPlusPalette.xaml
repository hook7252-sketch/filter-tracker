<Window x:Class="DreamPlus.UI.DreamPlusPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DreamPlus"
        Width="280" MinWidth="240"
        Height="600" MinHeight="400"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- 공통 버튼 스타일 -->
        <Style x:Key="CmdBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 섹션 헤더 스타일 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="✦ DreamPlus" FontSize="14" FontWeight="Bold"
                           Foreground="#CBA6F7" FontFamily="Malgun Gothic" VerticalAlignment="Center"/>
                <TextBlock Text="  AutoCAD Plugin" FontSize="11"
                           Foreground="#6C7086" FontFamily="Malgun Gothic" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 명령 목록 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,6">
            <StackPanel>

                <!-- ── 레이어 관리 ── -->
                <TextBlock Text="◈ 레이어 관리" Style="{StaticResource SectionHeader}"/>
                <Button Content="  새 레이어 만들기" Style="{StaticResource CmdBtn}" Tag="DP_LAYER_NEW" Click="OnCommandClick"/>
                <Button Content="  레이어 색상 변경" Style="{StaticResource CmdBtn}" Tag="DP_LAYER_COLOR" Click="OnCommandClick"/>
                <Button Content="  현재 레이어 외 동결" Style="{StaticResource CmdBtn}" Tag="DP_LAYER_FREEZE_OTHERS" Click="OnCommandClick"/>
                <Button Content="  모든 레이어 동결 해제" Style="{StaticResource CmdBtn}" Tag="DP_LAYER_THAW_ALL" Click="OnCommandClick"/>
                <Button Content="  레이어 목록 보기" Style="{StaticResource CmdBtn}" Tag="DP_LAYER_LIST" Click="OnCommandClick"/>
                <Button Content="  빈 레이어 삭제" Style="{StaticResource CmdBtn}" Tag="DP_LAYER_DELETE_EMPTY" Click="OnCommandClick"/>

                <!-- ── 블록/도면 관리 ── -->
                <TextBlock Text="◈ 블록 / 도면 관리" Style="{StaticResource SectionHeader}"/>
                <Button Content="  외부 블록 삽입" Style="{StaticResource CmdBtn}" Tag="DP_BLOCK_INSERT" Click="OnCommandClick"/>
                <Button Content="  블록 목록 보기" Style="{StaticResource CmdBtn}" Tag="DP_BLOCK_LIST" Click="OnCommandClick"/>
                <Button Content="  블록 개수 세기" Style="{StaticResource CmdBtn}" Tag="DP_BLOCK_COUNT" Click="OnCommandClick"/>
                <Button Content="  블록 일괄 분해" Style="{StaticResource CmdBtn}" Tag="DP_BLOCK_EXPLODE_ALL" Click="OnCommandClick"/>
                <Button Content="  블록 이름 교체" Style="{StaticResource CmdBtn}" Tag="DP_BLOCK_REPLACE" Click="OnCommandClick"/>

                <!-- ── 문자/치수 ── -->
                <TextBlock Text="◈ 문자 / 치수 도구" Style="{StaticResource SectionHeader}"/>
                <Button Content="  텍스트 높이 변경" Style="{StaticResource CmdBtn}" Tag="DP_TEXT_HEIGHT" Click="OnCommandClick"/>
                <Button Content="  텍스트 스타일 변경" Style="{StaticResource CmdBtn}" Tag="DP_TEXT_STYLE" Click="OnCommandClick"/>
                <Button Content="  텍스트 레이어 이동" Style="{StaticResource CmdBtn}" Tag="DP_TEXT_LAYER" Click="OnCommandClick"/>
                <Button Content="  치수 스타일 변경" Style="{StaticResource CmdBtn}" Tag="DP_DIM_STYLE" Click="OnCommandClick"/>
                <Button Content="  치수 전체 축척 변경" Style="{StaticResource CmdBtn}" Tag="DP_DIM_SCALE" Click="OnCommandClick"/>

                <!-- ── 내보내기/배치 ── -->
                <TextBlock Text="◈ 내보내기 / 배치" Style="{StaticResource SectionHeader}"/>
                <Button Content="  PDF 출력" Style="{StaticResource CmdBtn}" Tag="DP_PLOT_PDF" Click="OnCommandClick"/>
                <Button Content="  DXF 내보내기" Style="{StaticResource CmdBtn}" Tag="DP_EXPORT_DXF" Click="OnCommandClick"/>
                <Button Content="  새 레이아웃 생성" Style="{StaticResource CmdBtn}" Tag="DP_LAYOUT_NEW" Click="OnCommandClick"/>
                <Button Content="  레이아웃 복사" Style="{StaticResource CmdBtn}" Tag="DP_LAYOUT_COPY" Click="OnCommandClick"/>
                <Button Content="  레이아웃 목록 보기" Style="{StaticResource CmdBtn}" Tag="DP_LAYOUT_LIST" Click="OnCommandClick"/>

                <Border Height="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
