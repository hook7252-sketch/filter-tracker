<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CivilRun_MadeByHouuu</AssemblyName>
    <RootNamespace>CivilRun_MadeByHouuu</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <!-- AutoCAD 설치 경로 (환경에 맞게 수정) -->
    <AutoCadPath>C:\Program Files\Autodesk\AutoCAD 2024</AutoCadPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD .NET API NuGet 패키지 -->
    <PackageReference Include="AutoCAD.NET.Core" Version="24.0.0" />
    <PackageReference Include="AutoCAD.NET.Model" Version="24.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 리본 UI를 위한 AdWindows 참조 -->
    <Reference Include="AdWindows">
      <HintPath>$(AutoCadPath)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- AutoCAD DLL이 로컬에 있을 경우 직접 참조 (NuGet 대신 사용 가능) -->
